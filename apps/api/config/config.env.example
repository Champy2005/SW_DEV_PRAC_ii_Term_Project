NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/workshop-registration
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRE=1d
JWT_COOKIE_EXPIRE=1
FRONTEND_URL=http://localhost:3000
