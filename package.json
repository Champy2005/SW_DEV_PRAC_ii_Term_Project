{
  "name": "workshop-registration",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.0.0 <25" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:demo": "node scripts/demo.mjs",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo",
    "db:seed": "npm run seed -w apps/api",
    "db:seed:scenarios": "npm run seed -w apps/api -- --scenarios",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "npm run test -w apps/web",
    "test:api": "npm test -w apps/api",
    "test:e2e": "playwright test",
    "build": "npm run build -w apps/web",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^9.2.1"
  }
}
